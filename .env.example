# Папка с видео на USB-диске
MEDIA_ROOT=/mnt/usb/videos
# Пароль для входа в UI
CINEMA_PASSWORD=change-me
# Ключ подписи cookie — сгенерировать: openssl rand -hex 32
CINEMA_SECRET=
PORT=8090
HOST=0.0.0.0
SESSION_DAYS=30
# Перекодирование (нужен ffmpeg: sudo apt install ffmpeg)
# Кеш извлечённых встроенных субтитров — лучше на SSD
CACHE_DIR=/srv/storage/apps/streamserver/cache
# Сколько потоков ffmpeg одновременно (Pi 5: 1 перекодирование видео или 2–3 только звука)
MAX_TRANSCODES=2
# ultrafast | superfast | veryfast — чем быстрее, тем хуже качество
X264_PRESET=veryfast
AUDIO_BITRATE=192k
