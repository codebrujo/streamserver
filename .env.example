# Папка с видео на USB-диске
MEDIA_ROOT=/mnt/usb/videos
# Пароль для входа в UI
CINEMA_PASSWORD=change-me
# Ключ подписи cookie — сгенерировать: openssl rand -hex 32
CINEMA_SECRET=
PORT=8090
HOST=0.0.0.0
SESSION_DAYS=30
# Перекодирование (нужен ffmpeg: sudo apt install ffmpeg)
# Кеш извлечённых встроенных субтитров — лучше на SSD
CACHE_DIR=/srv/storage/apps/streamserver/cache
# Одновременные потоки через ffmpeg, отдельно по «тяжести»:
# видео копируется, перекодируется только звук (большинство MKV) — почти не грузит процессор
MAX_AUDIO_TRANSCODES=6
# перекодирование видео в H.264 (Xvid/DivX, HEVC, 10-bit): SD ~1 ядро, 1080p — весь Pi 5
MAX_VIDEO_TRANSCODES=2
# ultrafast | superfast | veryfast — чем быстрее, тем хуже качество
X264_PRESET=veryfast
AUDIO_BITRATE=192k
# Музыка (необязательно): папка с аудио включает вкладку «Музыка»
MUSIC_ROOT=/media/pi/MyBook/Media/Audio
# Кеш нарезанных CUE-треков и перекодированного аудио, МБ (старые удаляются)
MUSIC_CACHE_MB=2048
# Битрейт AAC в режиме «Экономно»
MUSIC_ECO_BITRATE=192k
# Очистка кеша раз в сутки: удалять то, к чему не обращались столько дней
CACHE_MAX_AGE_DAYS=90
